# Generated output. Rebuilt from docs/ and design/, never edited.
build/

# Real prospect and customer material (FS-069).
clients/

# Confidential source documents (FS-015, FS-069).
sources/confidential/

# GateKeepr documents are snapshots. Their authoritative copies live in the
# GateKeepr repository, and they name a real estate and its correspondence.
sources/gatekeepr/

# Vendors' published material (FS-508): copyrighted, fetched again from
# the vendor, and only summarised in docs/competitors.md.
sources/market/

# The owner's handwritten design notes, photographed (FS-790): the source of the
# recon redesign, transcribed in its README.md beside them. Kept, not committed.
sources/dibon/recon-notes/

# Kenyan legislation fetched from Kenya Law (FS-429) is kept in git since
# FS-901: the texts every instrument card was read from, with the
# guidelines and superseded versions. The reports are background, not
# law, and large: they stay out.
sources/regulation/ke/reports/

# Tooling state.
.superpowers/
*.tmp

# Local tool configuration (paths are machine-specific).
.claude/

# OpenTofu (FS-932): state, provider caches and the values filled in for a
# run (sign-in ids, emails) never go in git; the .example beside them does.
.terraform/
*.tfstate
*.tfstate.*
*.auto.tfvars
.terraform.lock.hcl.bak
