{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dibon.co.ke/schemas/transactions/hold/1.0",
  "title": "Hold, model 1.0",
  "description": "An amount held on an account without moving it (docs/specs/transactions.md §4, FS-1163): a guarantor's pledge, an escrow's hold, a lien, a card's authorisation, funds not yet cleared, a court's order. A companion to the transaction, never a kind of one. Written in the subset tools/products/validate.js reads.",
  "type": "object",
  "required": ["hold_id", "institution", "account", "amount", "reason", "placed_by", "placed_at", "status_history"],
  "additionalProperties": false,
  "properties": {
    "hold_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "institution": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "account": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["loan", "deposit", "share", "ledger"]},
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$"}
      }
    },
    "amount": {
      "type": "object",
      "required": ["minor", "currency"],
      "additionalProperties": false,
      "properties": {"minor": {"type": "integer", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}
    },
    "reason": {"enum": ["guarantee", "escrow", "lien", "card_authorisation", "uncleared", "legal_order"]},
    "secures": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$"},
    "txid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "placed_by": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["person", "service", "rail"]},
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$"},
        "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
      }
    },
    "placed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "until": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "approval_ref": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$"},
    "status_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["status", "at"],
        "additionalProperties": false,
        "properties": {
          "status": {"enum": ["placed", "reduced", "released", "captured", "expired"]},
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "remaining": {
            "type": "object",
            "required": ["minor", "currency"],
            "additionalProperties": false,
            "properties": {"minor": {"type": "integer", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}
          },
          "txid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
        }
      }
    }
  }
}
