{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dibon.co.ke/schemas/lender-rules/product-vocabulary/0.1.0",
  "title": "Product vocabulary, version 0.1.0",
  "description": "The typed form of each term in lender-rules §2.4 (FS-823, FS-825). One property per term, keyed by its name in lower case with underscores. Written in the subset tools/products/validate.js reads.",
  "$defs": {
    "kes": {"type": "number", "minimum": 0},
    "currency": {"const": "KES"},
    "days": {"type": "integer", "minimum": 0},
    "percent": {"type": "number", "minimum": 0, "maximum": 100},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "per": {"enum": ["term", "day", "week", "month", "year"]},
    "tier": {
      "type": "object",
      "required": ["from", "to", "amount"],
      "additionalProperties": false,
      "properties": {"from": {"$ref": "#/$defs/kes"}, "to": {"$ref": "#/$defs/kes"}, "amount": {"$ref": "#/$defs/kes"}}
    },
    "term_length": {
      "type": "object",
      "required": ["unit"],
      "additionalProperties": false,
      "properties": {
        "allowed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "exclusiveMinimum": 0}},
        "min": {"type": "integer", "exclusiveMinimum": 0},
        "max": {"type": "integer", "exclusiveMinimum": 0},
        "unit": {"enum": ["day", "week", "month"]}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "amount_limits": {
      "type": "object",
      "required": ["min", "max", "currency"],
      "additionalProperties": false,
      "properties": {"min": {"$ref": "#/$defs/kes"}, "max": {"$ref": "#/$defs/kes"}, "currency": {"$ref": "#/$defs/currency"}}
    },
    "term": {"$ref": "#/$defs/term_length"},
    "repayment_frequency": {
      "type": "object",
      "required": ["every"],
      "additionalProperties": false,
      "properties": {
        "every": {"enum": ["day", "week", "month", "maturity", "borrower_choice"]},
        "first_due": {"enum": ["day_after_disbursement", "week_after_disbursement", "month_after_disbursement", "maturity"]},
        "bounds": {"type": "array", "minItems": 1, "items": {"enum": ["day", "week", "month"]}}
      }
    },
    "facility": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["term_loan", "credit_line"]},
        "renews": {"enum": ["month", "quarter", "year", "never"]},
        "limit_basis": {"enum": ["assessed", "partner_purchases", "salary", "deposits_multiple"]},
        "draw_term": {"$ref": "#/$defs/term_length"}
      }
    },
    "repayment_source": {
      "type": "object",
      "required": ["sources"],
      "additionalProperties": false,
      "properties": {
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["borrower", "employer_check_off", "invoice_buyer", "till_share"]}},
        "till_share": {"$ref": "#/$defs/percent"}
      }
    },
    "interest_method": {
      "type": "object",
      "required": ["method"],
      "additionalProperties": false,
      "properties": {
        "method": {"enum": ["flat", "reducing_balance"]},
        "on": {"enum": ["principal"]},
        "instalments": {"enum": ["equal_instalments", "equal_principal"]}
      }
    },
    "interest_rate_and_its_unit": {
      "type": "object",
      "required": ["value", "unit", "per"],
      "additionalProperties": false,
      "properties": {"value": {"type": "number", "exclusiveMinimum": 0}, "unit": {"const": "percent"}, "per": {"$ref": "#/$defs/per"}}
    },
    "rate_type": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["fixed", "variable"]},
        "benchmark": {"enum": ["KESONIA", "CBR"]},
        "margin": {"type": "number"},
        "resets": {"enum": ["month", "quarter", "year"]}
      }
    },
    "rate_by_risk_class": {
      "type": "object",
      "required": ["by_risk_class"],
      "additionalProperties": false,
      "properties": {
        "by_risk_class": {"type": "boolean"},
        "range": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": {"min": {"type": "number", "exclusiveMinimum": 0}, "max": {"type": "number", "exclusiveMinimum": 0}}
        }
      }
    },
    "interest_basis": {
      "type": "object",
      "required": ["basis"],
      "additionalProperties": false,
      "properties": {
        "basis": {"enum": ["days_in_term", "actual_365", "30_360"]},
        "formula": {"type": "string"},
        "accrues": {"enum": ["daily", "at_disbursement"]}
      }
    },
    "fees": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "currency", "once_per", "taken"],
        "additionalProperties": false,
        "properties": {
          "name": {"$ref": "#/$defs/name"},
          "amount": {"$ref": "#/$defs/kes"},
          "percent": {"$ref": "#/$defs/percent"},
          "tiers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tier"}},
          "currency": {"$ref": "#/$defs/currency"},
          "once_per": {"enum": ["loan", "first_loan", "repeat_loan", "client"]},
          "taken": {"enum": ["disbursement", "schedule", "upfront"]},
          "refundable": {"type": "boolean"}
        }
      }
    },
    "tax_on_fees": {
      "type": "object",
      "required": ["excise_duty_percent", "on"],
      "additionalProperties": false,
      "properties": {
        "excise_duty_percent": {"$ref": "#/$defs/percent"},
        "on": {"const": "fees"},
        "not_on": {"type": "array", "uniqueItems": true, "items": {"enum": ["interest", "insurance_premium"]}}
      }
    },
    "who_pays_the_rails_charges": {
      "type": "object",
      "required": ["payer"],
      "additionalProperties": false,
      "properties": {"payer": {"enum": ["borrower", "institution"]}}
    },
    "third_party_costs": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kind"],
            "additionalProperties": false,
            "properties": {"name": {"$ref": "#/$defs/name"}, "kind": {"enum": ["institution_fee", "third_party_at_cost"]}}
          }
        }
      }
    },
    "insurance": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "amount": {"$ref": "#/$defs/kes"},
        "currency": {"$ref": "#/$defs/currency"},
        "taken": {"enum": ["disbursement", "schedule", "upfront"]},
        "kind": {"enum": ["fee", "third_party_premium", "none"]},
        "cover": {"enum": ["credit_life", "credit_life_and_disability", "other"]}
      }
    },
    "grace": {
      "type": "object",
      "required": ["days"],
      "additionalProperties": false,
      "properties": {"days": {"$ref": "#/$defs/days"}}
    },
    "default_interest": {
      "type": "object",
      "required": ["rate", "unit", "per", "base", "from_day_past_due"],
      "additionalProperties": false,
      "properties": {
        "rate": {"type": "number", "minimum": 0},
        "unit": {"const": "percent"},
        "per": {"$ref": "#/$defs/per"},
        "base": {"enum": ["principal_outstanding", "overdue_amount", "overdue_instalments"]},
        "from_day_past_due": {"type": "integer", "minimum": 1}
      }
    },
    "default_period": {
      "type": "object",
      "required": ["days_past_due"],
      "additionalProperties": false,
      "properties": {"days_past_due": {"type": "integer", "minimum": 1}}
    },
    "collateral": {
      "type": "object",
      "required": ["types"],
      "additionalProperties": false,
      "properties": {
        "types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["unsecured", "vehicle", "chattels", "land", "deposits", "financed_goods", "receivables", "salary"]}},
        "loan_to_value": {"$ref": "#/$defs/percent"}
      }
    },
    "guarantors": {
      "type": "object",
      "required": ["count"],
      "additionalProperties": false,
      "properties": {"count": {"type": "integer", "minimum": 0}, "limit": {"$ref": "#/$defs/kes"}}
    },
    "restructuring": {
      "type": "object",
      "required": ["allowed"],
      "additionalProperties": false,
      "properties": {"allowed": {"type": "boolean"}, "max_times": {"type": "integer", "minimum": 0}, "fee": {"$ref": "#/$defs/kes"}}
    },
    "statements": {
      "type": "object",
      "required": ["every", "to"],
      "additionalProperties": false,
      "properties": {
        "every": {"enum": ["instalment", "month", "quarter"]},
        "to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["borrower", "guarantor"]}}
      }
    },
    "collection_ladder": {
      "type": "object",
      "required": ["counted_from", "stages"],
      "additionalProperties": false,
      "properties": {
        "counted_from": {"enum": ["disbursement", "due_date"]},
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stage", "from", "to"],
            "additionalProperties": false,
            "properties": {"stage": {"$ref": "#/$defs/name"}, "from": {"$ref": "#/$defs/days"}, "to": {"$ref": "#/$defs/days"}}
          }
        }
      }
    },
    "holiday_rule": {
      "type": "object",
      "required": ["due_on_holiday"],
      "additionalProperties": false,
      "properties": {"due_on_holiday": {"enum": ["next_working_day", "previous_working_day", "unchanged"]}}
    },
    "rounding": {
      "type": "object",
      "required": ["currency", "decimals"],
      "additionalProperties": false,
      "properties": {
        "currency": {"$ref": "#/$defs/currency"},
        "decimals": {"type": "integer", "minimum": 0, "maximum": 2},
        "instalment": {"enum": ["up_to_shilling", "nearest", "exact"]},
        "last_instalment": {"enum": ["remainder"]}
      }
    },
    "languages": {
      "type": "object",
      "required": ["languages"],
      "additionalProperties": false,
      "properties": {"languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["en", "sw"]}}}
    },
    "who_may_borrow": {
      "type": "object",
      "required": ["individuals", "businesses"],
      "additionalProperties": false,
      "properties": {
        "individuals": {"type": "boolean"},
        "businesses": {"type": "boolean"},
        "employment": {"type": "array", "uniqueItems": true, "items": {"enum": ["employed", "self_employed"]}},
        "min_age": {"type": "integer", "minimum": 18},
        "member_months": {"type": "integer", "minimum": 0}
      }
    },
    "affordability": {
      "type": "object",
      "required": ["max_instalment_percent_of_income", "from"],
      "additionalProperties": false,
      "properties": {
        "max_instalment_percent_of_income": {"$ref": "#/$defs/percent"},
        "from": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["bank_statement", "mpesa_statement", "payslip"]}},
        "months": {"type": "integer", "minimum": 1},
        "whose_inflows": {"enum": ["person", "business", "combined", "each_then_decide"]}
      }
    },
    "limits_by_kyc_tier": {
      "type": "object",
      "required": ["tiers"],
      "additionalProperties": false,
      "properties": {
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tier", "max"],
            "additionalProperties": false,
            "properties": {"tier": {"type": "string"}, "max": {"$ref": "#/$defs/kes"}}
          }
        }
      }
    },
    "first_loan_and_limit_growth": {
      "type": "object",
      "required": ["first_loan_max"],
      "additionalProperties": false,
      "properties": {
        "first_loan_max": {"$ref": "#/$defs/kes"},
        "growth_percent_per_loan": {"$ref": "#/$defs/percent"},
        "wait_days": {"$ref": "#/$defs/days"}
      }
    },
    "exposure": {
      "type": "object",
      "required": ["max_loans", "top_ups"],
      "additionalProperties": false,
      "properties": {
        "max_loans": {"type": "integer", "minimum": 1},
        "top_ups": {"type": "boolean"},
        "guarantor_max_total": {"$ref": "#/$defs/kes"}
      }
    },
    "bureau": {
      "type": "object",
      "required": ["lookup"],
      "additionalProperties": false,
      "properties": {"lookup": {"enum": ["every_application", "first_loan", "none"]}}
    },
    "approval_chain": {
      "type": "object",
      "required": ["stages"],
      "additionalProperties": false,
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role"],
            "additionalProperties": false,
            "properties": {"role": {"$ref": "#/$defs/name"}, "quorum": {"enum": ["one", "majority", "all"]}, "above": {"$ref": "#/$defs/kes"}}
          }
        }
      }
    },
    "documents": {
      "type": "object",
      "required": ["checklist"],
      "additionalProperties": false,
      "properties": {"checklist": {"type": "string"}}
    },
    "disbursement": {
      "type": "object",
      "required": ["channels"],
      "additionalProperties": false,
      "properties": {"channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}}
    },
    "payee": {
      "type": "object",
      "required": ["to"],
      "additionalProperties": false,
      "properties": {
        "to": {"enum": ["borrower", "third_party"]},
        "kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["supplier", "dealer", "school", "hospital", "insurer", "agro_dealer", "merchant"]}},
        "approved_list": {"type": "boolean"},
        "proof": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["invoice", "proforma", "quotation", "fee_structure", "premium_notice"]}},
        "part_to_borrower": {"type": "boolean"}
      }
    },
    "partner": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["distributor", "dealer", "school", "hospital", "insurer", "employer", "produce_buyer", "merchant"]},
        "shares_data": {"type": "boolean"},
        "pays_towards_price": {"$ref": "#/$defs/percent"},
        "first_loss": {"$ref": "#/$defs/percent"},
        "refunds_returns_to_loan": {"type": "boolean"}
      }
    },
    "cut_off": {
      "type": "object",
      "required": ["no_payout_from", "to", "zone"],
      "additionalProperties": false,
      "properties": {"no_payout_from": {"$ref": "#/$defs/time"}, "to": {"$ref": "#/$defs/time"}, "zone": {"const": "Africa/Nairobi"}}
    },
    "purposes": {
      "type": "object",
      "required": ["purposes"],
      "additionalProperties": false,
      "properties": {"purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}
    },
    "cooling_off_period": {
      "type": "object",
      "required": ["days", "meaning"],
      "additionalProperties": false,
      "properties": {"days": {"$ref": "#/$defs/days"}, "meaning": {"enum": ["withdrawal_after_signing", "wait_before_new_loan"]}}
    },
    "bureau_reporting": {
      "type": "object",
      "required": ["reporting"],
      "additionalProperties": false,
      "properties": {"reporting": {"type": "boolean"}}
    }
  }
}
