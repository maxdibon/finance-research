#!/bin/sh
# Runs before every commit (FS-074, FS-245).
# Enable once per clone:  git config core.hooksPath .githooks

# 1. Binary files only from the allow-list. A client's PDF was once swept in
#    by "git add -A"; the names check cannot read PDFs, so this guard does.
allowed=".githooks/allowed-binaries"
bad=0
git diff --cached --name-only --diff-filter=AM -z | while IFS= read -r -d '' f; do
  case "$f" in
    # FS-901: the law texts from Kenya Law, public; never the reports.
    sources/regulation/ke/reports/*) echo "pre-commit: the reports stay out of git (FS-901): $f"; exit 1 ;;
    sources/regulation/ke/*.pdf) ;;
    *.pdf|*.PDF|*.png|*.jpg|*.jpeg|*.gif|*.docx|*.xlsx|*.pptx|*.zip|*.txt.gz)
      if ! grep -Fxq -- "$f" "$allowed"; then
        echo "pre-commit: binary file not on $allowed: $f"
        exit 1
      fi ;;
  esac
done || bad=1
[ "$bad" -eq 0 ] || { echo "pre-commit: nothing committed."; exit 1; }

# 2. The document checks.
node tools/check.js || {
  echo "pre-commit: checks failed; nothing committed. Fix, or see tools/check.js."
  exit 1
}

# 3. The reader (FS-567): build/site/, linked HTML of the documents, rebuilt
#    after the checks pass so it always matches the last commit. A failure
#    here warns and does not block: the reader is a reading aid.
node tools/site.js >/dev/null 2>&1 || echo "pre-commit: warning: build/site/ not rebuilt; run node tools/site.js to see why."
